<Window x:Class="StudyTask.CuratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кабинет куратора"
        Height="620"
        Width="940"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <DockPanel Margin="16">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="TitleTextBlock"
                       Text="Мои задачи"
                       FontSize="22"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <Button x:Name="CreateTaskButton"
                    Content="Создать задачу"
                    Width="170"
                    Height="34"
                    HorizontalAlignment="Right"
                    Click="CreateTaskButton_Click"/>
        </Grid>

        <DataGrid x:Name="TasksGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F5F7FA">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название"
                                    Binding="{Binding Title}"
                                    Width="*"/>
                <DataGridTextColumn Header="Дедлайн"
                                    Binding="{Binding Deadline, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                    Width="170"/>
                <DataGridTextColumn Header="Группа"
                                    Binding="{Binding TargetGroup.Name}"
                                    Width="160"/>
                <DataGridTextColumn Header="Тип"
                                    Binding="{Binding Type}"
                                    Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>