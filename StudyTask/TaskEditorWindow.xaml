<Window x:Class="StudyTask.TaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новая задача"
        Height="520"
        Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize">

    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Название" VerticalAlignment="Top" Margin="0,8,0,12"/>
        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TitleTextBox"
                   Height="32" Padding="6,4" Margin="0,0,0,12" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Описание" VerticalAlignment="Top" Margin="0,8,0,12"/>
        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="DescriptionTextBox"
                   Height="96" Padding="6,4" Margin="0,0,0,12"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Дедлайн" VerticalAlignment="Center" Margin="0,0,0,12"/>
        <DatePicker Grid.Row="2" Grid.Column="1" x:Name="DeadlinePicker"
                    Height="32" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Тип задачи" VerticalAlignment="Center" Margin="0,0,0,12"/>
        <ComboBox  Grid.Row="3" Grid.Column="1" x:Name="TaskTypeComboBox"
                   Height="32" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Группа" VerticalAlignment="Center" Margin="0,0,0,12"/>
        <ComboBox  Grid.Row="4" Grid.Column="1" x:Name="GroupComboBox"
                   Height="32" Margin="0,0,0,12"/>

        <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                x:Name="SaveButton"
                Content="Сохранить"
                Height="38"
                VerticalAlignment="Bottom"
                Click="SaveButton_Click"/>
    </Grid>
</Window>