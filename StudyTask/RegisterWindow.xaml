<Window x:Class="StudyTask.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация пользователя"
        Height="540"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize">

    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="ФИО" VerticalAlignment="Center" Margin="0,0,0,12"/>
        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="FullNameTextBox"
                   Height="32" Padding="6,4" Margin="0,0,0,12" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Логин" VerticalAlignment="Center" Margin="0,0,0,12"/>
        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="LoginTextBox"
                   Height="32" Padding="6,4" Margin="0,0,0,12" VerticalContentAlignment="Center"/>

        <TextBlock     Grid.Row="2" Grid.Column="0" Text="Пароль" VerticalAlignment="Center" Margin="0,0,0,12"/>
        <PasswordBox   Grid.Row="2" Grid.Column="1" x:Name="PasswordBox"
                       Height="32" Padding="6,4" Margin="0,0,0,12" VerticalContentAlignment="Center"/>

        <TextBlock     Grid.Row="3" Grid.Column="0" Text="Повтор пароля" VerticalAlignment="Center" Margin="0,0,0,12"/>
        <PasswordBox   Grid.Row="3" Grid.Column="1" x:Name="ConfirmPasswordBox"
                       Height="32" Padding="6,4" Margin="0,0,0,12" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Роль" VerticalAlignment="Center" Margin="0,0,0,12"/>
        <ComboBox  Grid.Row="4" Grid.Column="1" x:Name="RoleComboBox"
                   Height="32" Margin="0,0,0,12"
                   SelectionChanged="RoleComboBox_SelectionChanged"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Группа" VerticalAlignment="Center" Margin="0,0,0,12"/>
        <ComboBox  Grid.Row="5" Grid.Column="1" x:Name="GroupComboBox"
                   Height="32" Margin="0,0,0,12"
                   IsEnabled="False"/>

        <Button Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                x:Name="RegisterButton"
                Content="Зарегистрироваться"
                Height="38"
                VerticalAlignment="Bottom"
                Click="RegisterButton_Click"/>
    </Grid>
</Window>